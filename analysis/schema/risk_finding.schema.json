{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk_finding.schema.json",
  "title": "RiskFinding",
  "type": "object",
  "required": [
    "finding_id",
    "candidate_id",
    "analyzer",
    "is_risky",
    "severity",
    "confidence",
    "cwe",
    "evidence",
    "verdict"
  ],
  "properties": {
    "finding_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "chat_id": {"type": "string"},
    "turn_index": {"type": ["integer", "null"], "minimum": 0},
    "analyzer": {
      "type": "string",
      "enum": ["llm_judge", "static_rule", "dynamic_test", "fusion"]
    },
    "is_risky": {"type": "boolean"},
    "is_actionable": {"type": "boolean"},
    "actionability_reason": {"type": "string"},
    "severity": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "critical"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_tier": {
      "type": "string",
      "enum": ["high", "medium", "low", "excluded"]
    },
    "risk_confidence_tier": {
      "type": "string",
      "enum": ["high", "medium", "low", "excluded"]
    },
    "cwe_confidence_tier": {
      "type": "string",
      "enum": ["high", "medium", "low", "unmapped", "excluded"]
    },
    "cwe": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}
    },
    "cwe_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}
    },
    "primary_cwe": {"type": ["string", "null"], "pattern": "^CWE-[0-9]+$"},
    "cwe_abstraction": {
      "type": ["string", "null"],
      "enum": ["Pillar", "Class", "Base", "Variant", "Compound", "Category", "" , null]
    },
    "cwe_candidates_considered": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}
    },
    "rejected_cwes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cwe", "reason"],
        "properties": {
          "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "cwe_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "cwe_specificity": {
      "type": "string",
      "enum": ["specific", "broad", "ambiguous", "unmapped"]
    },
    "needs_human_cwe_review": {"type": "boolean"},
    "analyzers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "agreement": {
      "type": "string",
      "enum": ["semgrep_only", "llm_judge_only", "both", "unknown"]
    },
    "source_finding_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["quote", "reason"],
            "properties": {
              "quote": {"type": "string"},
              "reason": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        {"type": "object"}
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["possible", "likely", "confirmed", "not_risky"]
    },
    "rule_id": {"type": ["string", "null"]},
    "details": {"type": "object"}
  },
  "additionalProperties": false
}
